@prefix lv2:    <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix doap:   <http://usefulinc.com/ns/doap#> .
@prefix foaf:   <http://xmlns.com/foaf/0.1/> .
@prefix atom:   <http://lv2plug.in/ns/ext/atom#> .
@prefix midi:   <http://lv2plug.in/ns/ext/midi#> .
@prefix urid:   <http://lv2plug.in/ns/ext/urid#> .
@prefix opts:   <http://lv2plug.in/ns/ext/options#> .
@prefix work:   <http://lv2plug.in/ns/ext/worker#> .
@prefix state:  <http://lv2plug.in/ns/ext/state#> .
@prefix bufsz:  <http://lv2plug.in/ns/ext/buf-size#> .
@prefix pprops: <http://lv2plug.in/ns/ext/port-props#> .
@prefix units:  <http://lv2plug.in/ns/extensions/units#> .

<urn:ponzik:test#me> a foaf:Person ; foaf:name "Ponzik" .

# A stereo gain: options, worker and state.
<urn:ponzik:test:gain>
    a lv2:Plugin , lv2:AmplifierPlugin ;
    doap:name "Ponzik Test Gain" ;
    doap:maintainer <urn:ponzik:test#me> ;
    lv2:requiredFeature urid:map , opts:options , work:schedule , bufsz:boundedBlockLength ;
    lv2:optionalFeature lv2:hardRTCapable ;
    lv2:extensionData state:interface , work:interface ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in_l" ; lv2:name "In L"
    ] , [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 1 ; lv2:symbol "in_r" ; lv2:name "In R"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_l" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 3 ; lv2:symbol "out_r" ; lv2:name "Out R"
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 4 ; lv2:symbol "gain" ; lv2:name "Gain" ;
        lv2:default 1.0 ; lv2:minimum 0.0 ; lv2:maximum 2.0
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 5 ; lv2:symbol "mode" ; lv2:name "Mode" ;
        lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 4 ;
        lv2:portProperty lv2:integer , lv2:enumeration ;
        lv2:scalePoint [ rdfs:label "One" ; rdf:value 1 ] ,
                       [ rdfs:label "Two" ; rdf:value 2 ] ,
                       [ rdfs:label "Four" ; rdf:value 4 ]
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 6 ; lv2:symbol "freq" ; lv2:name "Frequency" ;
        lv2:default 0.01 ; lv2:minimum 0.0005 ; lv2:maximum 0.5 ;
        lv2:portProperty lv2:sampleRate , pprops:logarithmic
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 7 ; lv2:symbol "mute" ; lv2:name "Mute" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 8 ; lv2:symbol "delay" ; lv2:name "Delay" ;
        lv2:default 20 ; lv2:minimum 1 ; lv2:maximum 500 ; units:unit units:ms
    ] , [
        a lv2:ControlPort , lv2:OutputPort ; lv2:index 9 ; lv2:symbol "worked" ; lv2:name "Worked"
    ] , [
        a lv2:ControlPort , lv2:OutputPort ; lv2:index 10 ; lv2:symbol "latency" ; lv2:name "Latency" ;
        lv2:portProperty lv2:reportsLatency , lv2:integer
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 11 ; lv2:symbol "hidden" ; lv2:name "Hidden" ;
        lv2:default 3 ; lv2:minimum 0 ; lv2:maximum 9 ; lv2:portProperty pprops:notOnGUI
    ] .

# A sine instrument played over MIDI.
<urn:ponzik:test:synth>
    a lv2:Plugin , lv2:InstrumentPlugin ;
    doap:name "Ponzik Test Synth" ;
    doap:maintainer <urn:ponzik:test#me> ;
    lv2:requiredFeature urid:map ;
    lv2:port [
        a atom:AtomPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "midi" ; lv2:name "MIDI" ;
        atom:bufferType atom:Sequence ; atom:supports midi:MidiEvent
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out_l" ; lv2:name "Out L"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "out_r" ; lv2:name "Out R"
    ] , [
        a lv2:ControlPort , lv2:InputPort ; lv2:index 3 ; lv2:symbol "level" ; lv2:name "Level" ;
        lv2:default 0.5 ; lv2:minimum 0 ; lv2:maximum 1
    ] , [
        a lv2:CVPort , lv2:InputPort ; lv2:index 4 ; lv2:symbol "cv" ; lv2:name "CV"
    ] .

# A mono copy that needs every block to be as long.
<urn:ponzik:test:fixed>
    a lv2:Plugin ;
    doap:name "Ponzik Test Fixed" ;
    lv2:requiredFeature urid:map , opts:options , bufsz:fixedBlockLength ;
    lv2:port [
        a lv2:AudioPort , lv2:InputPort ; lv2:index 0 ; lv2:symbol "in" ; lv2:name "In"
    ] , [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 1 ; lv2:symbol "out" ; lv2:name "Out"
    ] , [
        a lv2:ControlPort , lv2:OutputPort ; lv2:index 2 ; lv2:symbol "bad" ; lv2:name "Bad blocks"
    ] .

# Needs a feature nobody has: skipped by the scan.
<urn:ponzik:test:magic>
    a lv2:Plugin ;
    doap:name "Ponzik Test Magic" ;
    lv2:requiredFeature <urn:ponzik:magic> ;
    lv2:port [
        a lv2:AudioPort , lv2:OutputPort ; lv2:index 0 ; lv2:symbol "out" ; lv2:name "Out"
    ] .
